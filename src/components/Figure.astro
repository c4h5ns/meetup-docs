---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { LocalImageProps } from "astro:assets";
import type { RemoteImageProps } from "astro:assets";

type Props = (LocalImageProps | RemoteImageProps) & { caption?: string };

const { src, alt, caption, class: class_, ...props } = Astro.props;
---

<figure class="custom-figure">
  {
    typeof src !== "string" ? (
      <Image
        src={src}
        alt={alt || caption || ""}
        class:list={["zoomable-image p-4 rounded-md",  class_]}
        {...props}
      />
    ) : (
      <img
        src={src}
        alt={alt || caption || ""}
        class:list={["zoomable-image", class_]}
        {...props}
      />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .custom-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 2rem 0;
  }

  .custom-figure img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    cursor: zoom-in;
  }

  .custom-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.9em;
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>

<script>
  import mediumZoom from "medium-zoom";

  const initZoom = () => {
    mediumZoom(".zoomable-image", {
      margin: 24,
      background: "var(--sl-color-bg-overlay, rgba(0, 0, 0, 0.8))",
    });
  };

  initZoom();
  document.addEventListener("astro:after-swap", initZoom);
</script>
